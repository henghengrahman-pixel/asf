<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard - DP Checker</title><link rel="stylesheet" href="/app.css"></head><body><header class="topbar"><div><b>DP CHECKER PANEL</b><span> · <%= dateWib %></span></div><form method="post" action="/logout"><button class="btn ghost">Logout</button></form></header><div class="layout"><aside class="sidebar"><a class="active" href="/">Dashboard</a><a href="/check">Cek DP Hari Ini</a><a href="/history">Riwayat Rekap</a><a href="/session-agent">Session Agen</a></aside><main class="content"><section class="hero"><h1>Dashboard</h1><p>Batch cek UserId → Cari → History Bank popup → hitung DP hari ini.</p></section><div class="cards"><div class="card"><span>Session Agen</span><strong class="<%= connected?'ok':'bad' %>"><%= connected?'TERPASANG':'BELUM ADA' %></strong></div><div class="card"><span>Rekap Tersimpan</span><strong><%= history.length %></strong></div></div><div class="actions"><a class="btn primary" href="/check">+ MULAI CEK DP</a><a class="btn secondary" href="/session-agent">ATUR SESSION AGEN</a></div><section class="panel"><h2>Rekap Terbaru</h2><% if(!history.length){ %><p class="empty">Belum ada rekap.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Tanggal</th><th>Total ID</th><th>Ada DP</th><th>Tidak Ada DP</th><th>ID Tidak Valid</th><th>Total Nominal</th><th></th></tr></thead><tbody><% history.forEach(b=>{ %><tr><td><%= b.date %></td><td><%= b.summary.totalIds %></td><td><%= b.summary.hasDp %></td><td><%= b.summary.noDp %></td><td><%= b.summary.invalid %></td><td>Rp<%= money(b.summary.totalNominal) %></td><td><a href="/result/<%= b.id %>">Lihat</a></td></tr><% }) %></tbody></table></div><% } %></section></main></div></body></html>
