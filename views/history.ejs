<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Riwayat - DP Checker</title><link rel="stylesheet" href="/app.css"></head><body><header class="topbar"><div><b>DP CHECKER PANEL</b></div><form method="post" action="/logout"><button class="btn ghost">Logout</button></form></header><div class="layout"><aside class="sidebar"><a href="/">Dashboard</a><a href="/check">Cek DP Hari Ini</a><a class="active" href="/history">Riwayat Rekap</a><a href="/session-agent">Session Agen</a></aside><main class="content"><section class="panel"><div class="space"><div><h1>Riwayat Rekap</h1><p class="muted">Maksimal 500 batch terbaru disimpan.</p></div><form method="post" action="/history/clear" onsubmit="return confirm('Hapus semua riwayat?')"><button class="btn danger">HAPUS RIWAYAT</button></form></div><div class="table-wrap"><table><thead><tr><th>Tanggal</th><th>Total ID</th><th>Ada DP</th><th>Tidak Ada DP</th><th>Tidak Valid</th><th>Total Nominal</th><th></th></tr></thead><tbody><% history.forEach(b=>{ %><tr><td><%= b.date %></td><td><%= b.summary.totalIds %></td><td><%= b.summary.hasDp %></td><td><%= b.summary.noDp %></td><td><%= b.summary.invalid %></td><td>Rp<%= money(b.summary.totalNominal) %></td><td><a href="/result/<%= b.id %>">Lihat</a></td></tr><% }) %></tbody></table></div></section></main></div></body></html>
