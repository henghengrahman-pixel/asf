<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Riwayat <%= site.name %> - DP Checker</title><link rel="stylesheet" href="/app.css"></head><body>
<header class="topbar"><div><b>DP CHECKER PANEL</b><span> · <%= site.name %></span></div><form method="post" action="/logout"><button class="btn ghost">Logout</button></form></header>
<div class="layout"><aside class="sidebar"><a href="/">← Dashboard</a><a href="/site/<%= site.id %>"><%= site.name %></a><a href="/site/<%= site.id %>/check">Cek DP</a><a class="active" href="/site/<%= site.id %>/history">Riwayat Rekap</a><a href="/site/<%= site.id %>/session-agent">Session Agent</a><div class="sidebar-label">WEBSITE LAIN</div><% activeSites.filter(s=>s.id!==site.id).forEach(s=>{ %><a href="/site/<%= s.id %>"><%= s.name %></a><% }) %></aside>
<main class="content"><section class="panel"><div class="space"><div><h1>Riwayat Rekap — <%= site.name %></h1><p class="muted">Riwayat hanya untuk website ini.</p></div><form method="post" action="/site/<%= site.id %>/history/clear" onsubmit="return confirm('Hapus semua riwayat <%= site.name %>?')"><button class="btn danger">HAPUS RIWAYAT</button></form></div><% if(!history.length){ %><p class="empty">Belum ada rekap.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Periode</th><th>Total ID</th><th>Ada DP</th><th>Tidak Ada DP</th><th>Tidak Valid</th><th>Total Nominal</th><th></th></tr></thead><tbody><% history.forEach(b=>{ %><tr><td><%= b.date %></td><td><%= b.summary.totalIds %></td><td><%= b.summary.hasDp %></td><td><%= b.summary.noDp %></td><td><%= b.summary.invalid %></td><td>Rp<%= money(b.summary.totalNominal) %></td><td><a href="/result/<%= b.id %>">Lihat</a></td></tr><% }) %></tbody></table></div><% } %></section></main></div></body></html>
