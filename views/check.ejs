<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cek DP - DP Checker</title><link rel="stylesheet" href="/app.css"></head><body><header class="topbar"><div><b>DP CHECKER PANEL</b></div><form method="post" action="/logout"><button class="btn ghost">Logout</button></form></header><div class="layout"><aside class="sidebar"><a href="/">Dashboard</a><a class="active" href="/check">Cek DP Hari Ini</a><a href="/history">Riwayat Rekap</a><a href="/session-agent">Session Agen</a></aside><main class="content"><section class="panel"><h1>Cek DP Hari Ini</h1><p class="muted">Masukkan banyak UserId. Satu ID per baris. Maksimal <%= maxIds %> ID.</p><% if(!connected){ %><div class="alert error">Session agen belum ada. <a href="/session-agent">Pasang session agen dahulu.</a></div><% } %><textarea id="ids" rows="14" placeholder="member001&#10;member002&#10;member003"></textarea><div class="row"><button id="start" class="btn primary" <%= connected?'':'disabled' %>>CEK SEMUA</button><span id="count" class="muted">0 ID</span></div></section><section id="progressBox" class="panel hidden"><h2>Proses Pengecekan</h2><div class="progress"><div id="bar"></div></div><div id="progressText">Menunggu...</div><div id="currentText" class="muted"></div><div id="liveResults" class="table-wrap"></div></section></main></div><script>
const ids=document.getElementById('ids'),count=document.getElementById('count'),btn=document.getElementById('start');let jobId=null,timer=null;
function parsed(){return [...new Set(ids.value.split(/[\n,;\s]+/).map(x=>x.trim()).filter(Boolean))]}
ids.addEventListener('input',()=>count.textContent=parsed().length+' ID');
btn?.addEventListener('click',async()=>{const list=parsed();if(!list.length)return alert('Masukkan minimal 1 UserId.');btn.disabled=true;document.getElementById('progressBox').classList.remove('hidden');const r=await fetch('/api/jobs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:list})});const j=await r.json();if(!j.ok){alert(j.error||'Gagal membuat job');btn.disabled=false;return}jobId=j.jobId;timer=setInterval(poll,1000);poll()});
async function poll(){const r=await fetch('/api/jobs/'+jobId);const j=await r.json();if(!j.ok)return;const x=j.job,total=x.ids?.length||0,pct=total?Math.round((x.current/total)*100):0;document.getElementById('bar').style.width=pct+'%';document.getElementById('progressText').textContent=`${x.current}/${total} (${pct}%) · ${x.status}`;document.getElementById('currentText').textContent=x.currentId?`UserId: ${x.currentId} · ${x.currentStep||''}`:'';render(x.results||[]);if(x.status==='done'){clearInterval(timer);location.href='/result/'+jobId}else if(x.status==='failed'){clearInterval(timer);alert(x.error||'Pengecekan gagal');btn.disabled=false}}
function render(rows){if(!rows.length)return;document.getElementById('liveResults').innerHTML='<table><thead><tr><th>UserId</th><th>Keterangan</th><th>Jml DP</th><th>Total</th></tr></thead><tbody>'+rows.map(r=>`<tr><td>${esc(r.userId)}</td><td>${esc(r.keterangan)}</td><td>${r.jumlahDp}</td><td>Rp${Number(r.totalDp||0).toLocaleString('id-ID')}</td></tr>`).join('')+'</tbody></table>'}
function esc(s){return String(s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
</script></body></html>
