<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= site.name %> - DP Checker</title><link rel="stylesheet" href="/app.css"></head><body>
<header class="topbar"><div><b>DP CHECKER PANEL</b><span> · <%= site.name %></span></div><form method="post" action="/logout"><button class="btn ghost">Logout</button></form></header>
<div class="layout"><aside class="sidebar"><a href="/">← Dashboard</a><a class="active" href="/site/<%= site.id %>"><%= site.name %></a><a href="/site/<%= site.id %>/check">Cek DP</a><a href="/site/<%= site.id %>/history">Riwayat Rekap</a><a href="/site/<%= site.id %>/session-agent">Session Agent</a></aside>
<main class="content"><section class="hero"><h1><%= site.name %></h1><p class="muted"><%= site.playerListUrl %></p><div class="actions"><a class="btn primary" href="/site/<%= site.id %>/check">CEK DP</a><a class="btn secondary" href="/site/<%= site.id %>/history">RIWAYAT REKAP</a><a class="btn secondary" href="/site/<%= site.id %>/session-agent">SESSION AGENT</a></div></section>
<div class="cards"><div class="card"><span>Session Agent</span><strong class="<%= connected?'ok':'bad' %>"><%= connected?'TERPASANG':'BELUM ADA' %></strong></div><div class="card"><span>Rekap Tersimpan</span><strong><%= history.length %></strong></div></div>
<section class="panel"><h2>Rekap Terbaru</h2><% if(!history.length){ %><p class="empty">Belum ada rekap.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Periode</th><th>Total ID</th><th>Ada DP</th><th>Tidak Ada DP</th><th>ID Tidak Valid</th><th>Total Nominal</th><th></th></tr></thead><tbody><% history.forEach(b=>{ %><tr><td><%= b.date %></td><td><%= b.summary.totalIds %></td><td><%= b.summary.hasDp %></td><td><%= b.summary.noDp %></td><td><%= b.summary.invalid %></td><td>Rp<%= money(b.summary.totalNominal) %></td><td><a href="/result/<%= b.id %>">Lihat</a></td></tr><% }) %></tbody></table></div><% } %></section>
</main></div></body></html>
