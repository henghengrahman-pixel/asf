<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rekap DP <%= site.name %> — MARKETING 8008</title><link rel="stylesheet" href="/app.css?v=marketing8008-v2"></head><body class="ri81-app crm-dp-app">
<aside class="sidebar"><div class="brand"><div><h2>MARKETING 8008</h2><small>CRM OPERASIONAL</small></div></div><nav>
<a href="/__crm_dashboard__">⌂ <span>Dashboard</span></a>
<div class="nav-label">WEBSITE</div>
<a class="site-title" href="/site/<%= site.id %>">◈ <span><%= site.name %></span></a>
<a class="" href="/site/<%= site.id %>/check">✓ <span>Cek DP</span></a>
<a class="" href="/site/<%= site.id %>/balance">◉ <span>Cek Saldo Member</span></a>
<a class="" href="/site/<%= site.id %>/history">▤ <span>Riwayat Rekap</span></a>
<a class="" href="/site/<%= site.id %>/session-agent">⚿ <span>Session Agent</span></a>
</nav><div class="side-footer"><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div><a href="/__crm_dashboard__">Dashboard</a></div></aside>
<main><header class="topbar"><div><strong><%= site.name %></strong><small>MARKETING 8008 • CRM TERPADU</small></div><div class="user-pill"><span class="avatar"><%= String(crmUser||'M').charAt(0).toUpperCase() %></span><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div></div></header><div class="content">
<section class="hero">
  <h1>REKAP DP — <%= site.name %></h1><p class="muted">Periode: <b><%= batch.period?.label || batch.date %></b></p>
  <div class="actions"><a class="btn primary" href="/site/<%= site.id %>/check">CEK LAGI</a><button class="btn primary" type="button" id="copyRecapBtn">SALIN REKAP</button><a class="btn secondary" href="/export/<%= batch.id %>.csv">EXPORT CSV</a></div><div id="copyStatus" class="copy-status"></div>
</section>
<div class="cards summary">
  <div class="card"><span>Total ID</span><strong><%= batch.summary.totalIds %></strong></div>
  <div class="card"><span>Ada DP</span><strong class="ok"><%= batch.summary.hasDp %></strong></div>
  <div class="card"><span>Tidak Ada DP</span><strong class="warn"><%= batch.summary.noDp %></strong></div>
  <div class="card"><span>ID Tidak Valid</span><strong class="bad"><%= batch.summary.invalid %></strong></div>
  <div class="card"><span>Total Transaksi DP Valid</span><strong><%= batch.summary.totalTransaksi %></strong></div>
  <div class="card"><span>Total DP Valid</span><strong>Rp<%= money(batch.summary.totalNominal) %></strong></div>
  <div class="card"><span>Bonus 50%</span><strong class="warn"><%= batch.summary.totalBonus50Transaksi || 0 %></strong></div>
  <div class="card"><span>Total Bonus 50%</span><strong class="warn">Rp<%= money(batch.summary.totalBonus50 || 0) %></strong></div>
</div>
<% const has=batch.results.filter(x=>x.status==='has_dp'); const no=batch.results.filter(x=>x.status==='no_dp'); const bad=batch.results.filter(x=>x.status==='invalid'); const errs=batch.results.filter(x=>x.status==='error'); const withBonus=batch.results.filter(x=>(x.jumlahBonus50||0)>0); %>
<section class="panel"><h2>✅ ADA DP (<%= has.length %>)</h2><% if(!has.length){ %><p class="empty">Tidak ada.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>No</th><th>UserId</th><th>DP Valid</th><th>Total DP</th><th>Bonus 50%</th><th>Retry</th><th>Transaksi</th></tr></thead><tbody><% has.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td><b><%= r.userId %></b></td><td><%= r.jumlahDp %></td><td>Rp<%= money(r.totalDp) %></td><td><%= r.jumlahBonus50||0 %> / Rp<%= money(r.totalBonus50||0) %></td><td><%= r.attemptUsed||1 %>x</td><td><a class="btn mini" href="/result/<%= batch.id %>/user/<%= encodeURIComponent(r.userId) %>">CEK LENGKAP</a></td></tr><% }) %></tbody></table></div><% } %></section>
<section class="panel"><h2>⚠️ TIDAK ADA DP (<%= no.length %>)</h2><% if(!no.length){ %><p class="empty">Tidak ada.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>No</th><th>UserId</th><th>Keterangan</th><th>Retry</th><th>Transaksi</th></tr></thead><tbody><% no.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td><b><%= r.userId %></b></td><td class="warn">Tidak ada DP pada periode</td><td><%= r.attemptUsed||1 %>x</td><td><a class="btn mini" href="/result/<%= batch.id %>/user/<%= encodeURIComponent(r.userId) %>">CEK LENGKAP</a></td></tr><% }) %></tbody></table></div><% } %></section>
<section class="panel"><h2>🎁 BONUS 50% (<%= batch.summary.totalBonus50Transaksi||0 %>)</h2><% if(!withBonus.length){ %><p class="empty">Tidak ada.</p><% } else { withBonus.forEach(r=>{ %><h3><%= r.userId %> — Rp<%= money(r.totalBonus50||0) %></h3><div class="table-wrap"><table><thead><tr><th>DP Utama</th><th>Jam DP</th><th>Bonus</th><th>Jam Bonus</th><th>Selisih</th><th>By</th></tr></thead><tbody><% (r.bonus50||[]).forEach(b=>{ %><tr><td>Rp<%= money(b.baseCoin) %></td><td><%= b.baseDate %></td><td>Rp<%= money(b.coin) %></td><td><%= b.date %></td><td><%= b.minutesAfter %> menit</td><td><%= b.by %></td></tr><% }) %></tbody></table></div><% }) } %></section>
<section class="panel"><h2>❌ ID TIDAK VALID (<%= bad.length %>)</h2><% if(!bad.length){ %><p class="empty">Tidak ada.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>No</th><th>UserId</th></tr></thead><tbody><% bad.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td class="bad"><b><%= r.userId %></b></td></tr><% }) %></tbody></table></div><% } %></section>
<% if(errs.length){ %><section class="panel"><h2>🔧 ERROR (<%= errs.length %>)</h2><div class="table-wrap"><table><thead><tr><th>No</th><th>UserId</th><th>Keterangan</th><th>Percobaan</th></tr></thead><tbody><% errs.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td><b><%= r.userId %></b></td><td class="bad"><%= r.keterangan %></td><td><%= r.attemptUsed||1 %></td></tr><% }) %></tbody></table></div></section><% } %>
<section class="panel recap-copy-panel"><h2>📋 REKAP SIAP COPY-PASTE</h2><textarea id="recapText" class="recap-text" readonly>📊 REKAP DP - <%= site.name %>
📅 Periode: <%= batch.period?.label || batch.date %>

✅ ADA DP (<%= has.length %>)
<% if(!has.length){ %>Tidak ada.
<% } else { has.forEach((r,i)=>{ %><%= i+1 %>. UserId: <%= r.userId %>
   DP Valid: <%= r.jumlahDp %> transaksi
   Total DP: Rp<%= money(r.totalDp) %>
<% if((r.jumlahBonus50||0)>0){ %>   Bonus 50%: <%= r.jumlahBonus50 %> transaksi / Rp<%= money(r.totalBonus50) %>
<% } %><% }) } %>
⚠️ TIDAK ADA DP (<%= no.length %>)
<% if(!no.length){ %>Tidak ada.
<% } else { no.forEach((r,i)=>{ %><%= i+1 %>. UserId: <%= r.userId %>
<% }) } %>
❌ ID TIDAK VALID (<%= bad.length %>)
<% if(!bad.length){ %>Tidak ada.
<% } else { bad.forEach((r,i)=>{ %><%= i+1 %>. UserId: <%= r.userId %>
<% }) } %>
<% if(errs.length){ %>🔧 ERROR (<%= errs.length %>)
<% errs.forEach((r,i)=>{ %><%= i+1 %>. <%= r.userId %> - <%= r.keterangan %>
<% }) } %>
━━━━━━━━━━━━━━━━━━━━
📌 RINGKASAN
Total ID Dicek: <%= batch.summary.totalIds %>
ID Valid: <%= batch.summary.valid %>
Ada DP: <%= batch.summary.hasDp %>
Tidak Ada DP: <%= batch.summary.noDp %>
ID Tidak Valid: <%= batch.summary.invalid %>
Total Transaksi DP Valid: <%= batch.summary.totalTransaksi %>
Total DP Valid: Rp<%= money(batch.summary.totalNominal) %>
Total Bonus 50%: <%= batch.summary.totalBonus50Transaksi||0 %> transaksi / Rp<%= money(batch.summary.totalBonus50||0) %>
━━━━━━━━━━━━━━━━━━━━</textarea><button class="btn primary" type="button" id="copyRecapBtnBottom">SALIN REKAP</button></section>
</div></main>
<script>(function(){const t=document.getElementById('recapText'),s=document.getElementById('copyStatus');async function copy(){try{if(navigator.clipboard&&window.isSecureContext)await navigator.clipboard.writeText(t.value.trim());else{t.focus();t.select();document.execCommand('copy')}s.textContent='✅ Rekap berhasil disalin.';setTimeout(()=>s.textContent='',2500)}catch{s.textContent='❌ Gagal copy otomatis.'}}document.getElementById('copyRecapBtn').onclick=copy;document.getElementById('copyRecapBtnBottom').onclick=copy})();</script>
</body></html>
