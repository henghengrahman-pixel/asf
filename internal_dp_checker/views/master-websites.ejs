<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Master Website - DP Checker</title><link rel="stylesheet" href="/app.css"></head><body>
<header class="topbar"><div><b>DP CHECKER PANEL</b><span> · MASTER WEBSITE</span></div><form method="post" action="/logout"><button class="btn ghost">Logout</button></form></header>
<div class="layout"><aside class="sidebar"><a href="/">Dashboard</a><a class="active" href="/master-websites">Master Website</a><div class="sidebar-label">WEBSITE AKTIF</div><% activeSites.forEach(s=>{ %><a href="/site/<%= s.id %>"><%= s.name %></a><% }) %></aside>
<main class="content"><section class="hero"><h1>Master Website</h1><p>Tambah website di sini. Jika status Aktif, nama website otomatis muncul di Dashboard dan menu.</p></section>
<% if(saved){ %><div class="alert success">Perubahan website berhasil disimpan.</div><% } %><% if(error){ %><div class="alert error"><%= error %></div><% } %>
<section class="panel"><h2>Tambah Website</h2><form method="post" action="/master-websites" class="stack"><label>Nama Website<input name="name" placeholder="RUPIAHTOTO" maxlength="60" required></label><label>URL Agent Player List<input name="playerListUrl" placeholder="https://agwl1.suksesbogil.com/agentplayerlist.php" required></label><label>Session / document.cookie (opsional)<textarea name="cookie" rows="4" placeholder="PHPSESSID=...; cookie_lain=..."></textarea></label><label class="checkline"><input type="checkbox" name="active" value="1" checked> Aktifkan website dan tampilkan di menu</label><button class="btn primary">TAMBAH WEBSITE</button></form></section>
<section class="panel"><h2>Daftar Website</h2><% if(!sites.length){ %><p class="empty">Belum ada website.</p><% } else { sites.forEach(s=>{ %><details class="site-edit" <%= sites.length===1?'open':'' %>><summary><span><b><%= s.name %></b> <small class="muted">· <%= s.baseUrl %></small></span><span class="status-pill <%= s.active?'okbg':'badbg' %>"><%= s.active?'AKTIF':'NONAKTIF' %></span></summary><form method="post" action="/master-websites/<%= s.id %>/update" class="stack site-edit-body"><label>Nama Website<input name="name" value="<%= s.name %>" required></label><label>URL Agent Player List<input name="playerListUrl" value="<%= s.playerListUrl %>" required></label><label>Ganti Session (kosongkan jika tidak ingin mengganti)<textarea name="cookie" rows="4" placeholder="<%= s.connected?'SESSION SUDAH TERSIMPAN':'PHPSESSID=...; cookie_lain=...' %>"></textarea></label><label class="checkline"><input type="checkbox" name="active" value="1" <%= s.active?'checked':'' %>> Aktif</label><div class="row"><button class="btn primary">SIMPAN PERUBAHAN</button><a class="btn secondary" href="/site/<%= s.id %>">BUKA WEBSITE</a><a class="btn secondary" href="/site/<%= s.id %>/session-agent"><%= s.connected?'SESSION TERSIMPAN':'ISI SESSION' %></a></div></form><form method="post" action="/master-websites/<%= s.id %>/delete" onsubmit="return confirm('Hapus website <%= s.name %>? Riwayat batch yang sudah tersimpan tidak otomatis dihapus.')"><button class="btn danger">HAPUS WEBSITE</button></form></details><% }) } %></section>
</main></div></body></html>
