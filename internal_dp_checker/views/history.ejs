<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Riwayat <%= site.name %> — MARKETING 8008</title><link rel="stylesheet" href="/app.css?v=marketing8008-v2"></head><body class="ri81-app crm-dp-app">
<aside class="sidebar"><div class="brand"><div><h2>MARKETING 8008</h2><small>CRM OPERASIONAL</small></div></div><nav>
<a href="/__crm_dashboard__">⌂ <span>Dashboard</span></a>
<div class="nav-label">WEBSITE</div>
<a class="site-title" href="/site/<%= site.id %>">◈ <span><%= site.name %></span></a>
<a class="" href="/site/<%= site.id %>/check">✓ <span>Cek DP</span></a>
<a class="" href="/site/<%= site.id %>/balance">◉ <span>Cek Saldo Member</span></a>
<a class="active" href="/site/<%= site.id %>/history">▤ <span>Riwayat Rekap</span></a>
<a class="" href="/site/<%= site.id %>/session-agent">⚿ <span>Session Agent</span></a>
</nav><div class="side-footer"><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div><a href="/__crm_dashboard__">Dashboard</a></div></aside>
<main><header class="topbar"><div><strong><%= site.name %></strong><small>MARKETING 8008 • CRM TERPADU</small></div><div class="user-pill"><span class="avatar"><%= String(crmUser||'M').charAt(0).toUpperCase() %></span><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div></div></header><div class="content"><section class="panel"><div class="space"><div><h1>Riwayat Rekap — <%= site.name %></h1><p class="muted">Riwayat hanya untuk website ini.</p></div><form method="post" action="/site/<%= site.id %>/history/clear" onsubmit="return confirm('Hapus semua riwayat <%= site.name %>?')"><button class="btn danger">HAPUS RIWAYAT</button></form></div><% if(!history.length){ %><p class="empty">Belum ada rekap.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Periode</th><th>Total ID</th><th>Ada DP</th><th>Tidak Ada DP</th><th>Tidak Valid</th><th>Total Nominal</th><th></th></tr></thead><tbody><% history.forEach(b=>{ %><tr><td><%= b.date %></td><td><%= b.summary.totalIds %></td><td><%= b.summary.hasDp %></td><td><%= b.summary.noDp %></td><td><%= b.summary.invalid %></td><td>Rp<%= money(b.summary.totalNominal) %></td><td><a href="/result/<%= b.id %>">Lihat</a></td></tr><% }) %></tbody></table></div><% } %></section></div></main></body></html>
