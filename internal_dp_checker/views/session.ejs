<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Session <%= site.name %> — MARKETING 8008</title><link rel="stylesheet" href="/app.css"></head><body class="crm-dp-app">
<aside class="sidebar"><div class="brand"><div><h2>MARKETING 8008</h2><small>CRM OPERASIONAL</small></div></div><nav>
<a href="/__crm_dashboard__">⌂ <span>Dashboard</span></a>
<div class="nav-label">WEBSITE</div>
<a class="site-title" href="/site/<%= site.id %>">◈ <span><%= site.name %></span></a>
<a class="" href="/site/<%= site.id %>/check">✓ <span>Cek DP</span></a>
<a class="" href="/site/<%= site.id %>/history">▤ <span>Riwayat Rekap</span></a>
<a class="active" href="/site/<%= site.id %>/session-agent">⚿ <span>Session Agent</span></a>
</nav><div class="side-footer"><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div><a href="/__crm_dashboard__">Dashboard</a></div></aside>
<main><header class="topbar"><div><strong><%= site.name %></strong><small>MARKETING 8008 • CRM TERPADU</small></div><div class="user-pill"><span class="avatar"><%= String(crmUser||'M').charAt(0).toUpperCase() %></span><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div></div></header><div class="content"><section class="panel"><h1>Session Agent — <%= site.name %></h1><p class="muted">URL: <%= site.playerListUrl %></p><p class="muted">Tempel nilai <code>document.cookie</code> / cookie session dari browser yang sedang login. Nilai session tidak ditampilkan kembali setelah disimpan.</p><div class="status-pill <%= connected?'okbg':'badbg' %>"><%= connected?'SESSION TERSIMPAN':'BELUM ADA SESSION' %></div><% if(saved){ %><div class="alert success">Session berhasil disimpan.</div><% } %><% if(error){ %><div class="alert error"><%= error %></div><% } %><form method="post" action="/site/<%= site.id %>/session-agent" class="stack"><label>Cookie Session<textarea name="cookie" rows="8" placeholder="PHPSESSID=...; cookie_lain=..." required></textarea></label><div class="row"><button class="btn primary">SIMPAN SESSION</button><button type="button" id="test" class="btn secondary">TEST SESSION</button></div></form><form method="post" action="/site/<%= site.id %>/session-agent/clear" onsubmit="return confirm('Hapus session <%= site.name %>?')"><button class="btn danger">HAPUS SESSION</button></form><div id="testResult"></div></section></div></main>
<script>document.getElementById('test').onclick=async()=>{const el=document.getElementById('testResult');el.innerHTML='<div class="alert">Mengecek...</div>';const r=await fetch('/site/<%= site.id %>/session-agent/test',{method:'POST'});const j=await r.json();el.innerHTML=`<div class="alert ${j.ok?'success':'error'}">${j.ok?j.message:j.error}</div>`}</script></body></html>
