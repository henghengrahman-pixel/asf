<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Transaksi <%= result.userId %> — MARKETING 8008</title><link rel="stylesheet" href="/app.css?v=marketing8008-v2"></head><body class="ri81-app crm-dp-app">
<aside class="sidebar"><div class="brand"><div><h2>MARKETING 8008</h2><small>CRM OPERASIONAL</small></div></div><nav>
<a href="/__crm_dashboard__">⌂ <span>Dashboard</span></a>
<div class="nav-label">WEBSITE</div>
<a class="site-title" href="/site/<%= site.id %>">◈ <span><%= site.name %></span></a>
<a class="" href="/site/<%= site.id %>/check">✓ <span>Cek DP</span></a>
<a class="" href="/site/<%= site.id %>/balance">◉ <span>Cek Saldo Member</span></a>
<a class="" href="/site/<%= site.id %>/history">▤ <span>Riwayat Rekap</span></a>
<a class="" href="/site/<%= site.id %>/session-agent">⚿ <span>Session Agent</span></a>
</nav><div class="side-footer"><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div><a href="/__crm_dashboard__">Dashboard</a></div></aside>
<main><header class="topbar"><div><strong><%= site.name %></strong><small>MARKETING 8008 • CRM TERPADU</small></div><div class="user-pill"><span class="avatar"><%= String(crmUser||'M').charAt(0).toUpperCase() %></span><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div></div></header><div class="content">
<section class="hero"><div class="space"><div><h1>History Bank — <%= result.userId %></h1><p class="muted">Tampilan transaksi lengkap mengikuti kolom agent: No · Date · Info · By · Coin · Last Coin.</p></div><a class="btn secondary" href="/result/<%= batch.id %>">← KEMBALI KE REKAP</a></div>
<div class="actions"><a class="btn <%= scope==='period'?'primary':'secondary' %>" href="?scope=period">PERIODE: <%= batch.period?.label || batch.date %></a><a class="btn <%= scope==='all'?'primary':'secondary' %>" href="?scope=all">SEMUA HISTORY YANG TAMPIL DI AGENT</a><a class="btn secondary" href="/export/<%= batch.id %>/user/<%= encodeURIComponent(result.userId) %>.csv?scope=<%= scope %>">EXPORT CSV</a></div></section>
<div class="cards summary"><div class="card"><span>Status</span><strong class="<%= result.status==='has_dp'?'ok':result.status==='no_dp'?'warn':'bad' %>"><%= result.keterangan %></strong></div><div class="card"><span>DP Valid</span><strong><%= result.jumlahDp||0 %></strong></div><div class="card"><span>Total DP Valid</span><strong>Rp<%= money(result.totalDp||0) %></strong></div><div class="card"><span>Bonus 50%</span><strong class="warn"><%= result.jumlahBonus50||0 %> / Rp<%= money(result.totalBonus50||0) %></strong></div><div class="card"><span>Total Transaksi Ditampilkan</span><strong><%= transactions.length %></strong></div><div class="card"><span>Percobaan</span><strong><%= result.attemptUsed||1 %>x</strong></div></div>
<section class="panel"><div class="space"><div><h2>Transaksi Lengkap</h2><p class="muted"><%= scope==='all'?'Semua baris History Bank yang berhasil dibaca dari popup agent.':'Semua jenis transaksi pada periode '+(batch.period?.label||batch.date)+'. Tidak difilter hanya deposit.' %></p></div><input id="searchTxn" class="search-small" placeholder="Cari Date / Info / By / Coin..."></div>
<% if(!transactions.length){ %><p class="empty">Tidak ada transaksi pada tampilan ini.</p><% } else { %><div class="table-wrap"><table id="txnTable"><thead><tr><th>No</th><th>Date</th><th>Info</th><th>By</th><th>Coin</th><th>Last Coin</th></tr></thead><tbody><% transactions.forEach((t,i)=>{ %><tr><td><%= t.no || i+1 %></td><td><%= t.date %></td><td><%= t.info %></td><td><%= t.by %></td><td>Rp<%= money(t.coin) %></td><td>Rp<%= money(t.lastCoin) %></td></tr><% }) %></tbody></table></div><% } %></section>
</div></main>
<script>const q=document.getElementById('searchTxn');q?.addEventListener('input',()=>{const v=q.value.toLowerCase();document.querySelectorAll('#txnTable tbody tr').forEach(tr=>tr.style.display=tr.innerText.toLowerCase().includes(v)?'':'none')});</script>
</body></html>
