<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cek Saldo <%= site.name %> — MARKETING 8008</title><link rel="stylesheet" href="/app.css?v=marketing8008-v3"></head><body class="ri81-app crm-dp-app">
<aside class="sidebar"><div class="brand"><div><h2>MARKETING 8008</h2><small>CRM OPERASIONAL</small></div></div><nav>
<a href="/__crm_dashboard__">⌂ <span>Dashboard</span></a>
<div class="nav-label">WEBSITE</div>
<a class="site-title" href="/site/<%= site.id %>">◈ <span><%= site.name %></span></a>
<a href="/site/<%= site.id %>/check">✓ <span>Cek DP</span></a>
<a class="active" href="/site/<%= site.id %>/balance">◉ <span>Cek Saldo Member</span></a>
<a href="/site/<%= site.id %>/history">▤ <span>Riwayat Rekap</span></a>
<a href="/site/<%= site.id %>/session-agent">⚿ <span>Session Agent</span></a>
</nav><div class="side-footer"><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div><a href="/__crm_dashboard__">Dashboard</a></div></aside>
<main><header class="topbar"><div><strong><%= site.name %></strong><small>MARKETING 8008 • CRM TERPADU</small></div><div class="user-pill"><span class="avatar"><%= String(crmUser||'M').charAt(0).toUpperCase() %></span><div><b><%= crmUser %></b><small><%= String(crmRole||'').toUpperCase() %></small></div></div></header><div class="content">
<section class="panel"><h1>Cek Saldo Member — <%= site.name %></h1><p class="muted">Masukkan satu atau banyak UserId. Sistem mencari member di Nama Pemain dan membaca Balance terbaru yang tampil di agent.</p><div class="mini-info"><span>Worker: <b><%= concurrency %></b></span><span>Retry: <b><%= retries %>x</b></span><span>Maksimal: <b><%= maxIds %> ID</b></span></div>
<% if(!connected){ %><div class="alert error">Session <%= site.name %> belum ada. <a href="/site/<%= site.id %>/session-agent">Pasang session dahulu.</a></div><% } %>
<label class="field-label">Daftar UserId</label><textarea id="ids" rows="14" placeholder="member001&#10;member002&#10;member003"></textarea><div class="row"><button id="start" class="btn primary" <%= connected?'':'disabled' %>>CEK SALDO SEMUA</button><span id="count" class="muted">0 ID</span></div></section>
<section id="progressBox" class="panel hidden"><div class="space"><div><h2>Progress Real-time</h2><div class="muted">Saldo dibaca langsung dari kolom Balance pada hasil pencarian member.</div></div><div id="doneBadge" class="status-pill okbg hidden">SELESAI</div></div><div class="progress"><div id="bar"></div></div><div id="progressText">Menunggu...</div><div id="liveItems" class="job-grid"></div><div class="panel-sub"><h3>Hasil yang Sudah Selesai</h3><div id="liveResults" class="table-wrap"><p class="empty">Belum ada hasil.</p></div></div></section>
</div></main>
<script>
const SITE_ID=<%- JSON.stringify(site.id) %>;const ids=document.getElementById('ids'),count=document.getElementById('count'),btn=document.getElementById('start');let jobId=null,timer=null;
function parsed(){return [...new Set(ids.value.split(/[\n,;\s]+/).map(x=>x.trim()).filter(Boolean))]}
ids.addEventListener('input',()=>count.textContent=parsed().length+' ID');
btn?.addEventListener('click',async()=>{const list=parsed();if(!list.length)return alert('Masukkan minimal 1 UserId.');btn.disabled=true;document.getElementById('progressBox').classList.remove('hidden');try{const r=await fetch('/site/'+encodeURIComponent(SITE_ID)+'/api/balance-jobs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:list})});const j=await r.json();if(!j.ok){alert(j.error||'Gagal membuat job saldo');btn.disabled=false;return}jobId=j.jobId;timer=setInterval(poll,700);poll()}catch(e){alert('Gagal membuat job saldo: '+e.message);btn.disabled=false}});
async function poll(){try{const r=await fetch('/api/balance-jobs/'+jobId);const j=await r.json();if(!j.ok)return;const x=j.job,total=x.ids?.length||0,done=x.completed||x.current||0,pct=total?Math.round((done/total)*100):0;document.getElementById('bar').style.width=pct+'%';document.getElementById('progressText').textContent=`${done}/${total} selesai (${pct}%) · ${x.status}`;renderItems(x.items||[]);renderResults(x.results||[]);if(x.status==='done'){clearInterval(timer);document.getElementById('doneBadge').classList.remove('hidden');setTimeout(()=>location.href='/balance-result/'+jobId,500)}else if(x.status==='failed'){clearInterval(timer);alert(x.error||'Pengecekan saldo gagal');btn.disabled=false}}catch(e){console.error(e)}}
function renderItems(items){const box=document.getElementById('liveItems');box.innerHTML=items.map(it=>{const cls=it.status==='valid'?'ok':it.status==='invalid'||it.status==='error'?'bad':'';const retry=it.attempt?` · percobaan ${it.attempt}/${it.maxAttempts||1}`:'';return `<div class="job-item"><div><b>${esc(it.userId)}</b><div class="muted small">${esc(it.step||'Menunggu')}${retry}</div></div><span class="${cls}">${labelStatus(it.status)}</span></div>`}).join('')}
function labelStatus(s){return ({queued:'Menunggu',running:'Proses',valid:'Valid',invalid:'ID tidak valid',error:'Error'})[s]||s}
function renderResults(rows){const box=document.getElementById('liveResults');if(!rows.length){box.innerHTML='<p class="empty">Belum ada hasil.</p>';return}box.innerHTML='<table><thead><tr><th>UserId</th><th>Status</th><th>Saldo Sekarang</th><th>Retry</th></tr></thead><tbody>'+rows.map(r=>`<tr><td><b>${esc(r.userId)}</b></td><td>${esc(r.keterangan)}</td><td>${r.status==='valid'?'Rp'+Number(r.balance||0).toLocaleString('id-ID'):'-'}</td><td>${r.attemptUsed||1} percobaan</td></tr>`).join('')+'</tbody></table>'}
function esc(s){return String(s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
</script></body></html>
