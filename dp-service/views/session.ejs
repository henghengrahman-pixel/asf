<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Session <%= site.name %> - DP Checker</title><link rel="stylesheet" href="/app.css"></head><body>
<header class="topbar"><div><b>DP CHECKER PANEL</b><span> · <%= site.name %></span></div><form method="post" action="/logout"><button class="btn ghost">Logout</button></form></header>
<div class="layout"><aside class="sidebar"><a href="/">← Dashboard</a><a href="/site/<%= site.id %>"><%= site.name %></a><a href="/site/<%= site.id %>/check">Cek DP</a><a href="/site/<%= site.id %>/history">Riwayat Rekap</a><a class="active" href="/site/<%= site.id %>/session-agent">Session Agent</a></aside>
<main class="content"><section class="panel"><h1>Session Agent — <%= site.name %></h1><p class="muted">URL: <%= site.playerListUrl %></p><p class="muted">Tempel nilai <code>document.cookie</code> / cookie session dari browser yang sedang login. Nilai session tidak ditampilkan kembali setelah disimpan.</p><div class="status-pill <%= connected?'okbg':'badbg' %>"><%= connected?'SESSION TERSIMPAN':'BELUM ADA SESSION' %></div><% if(saved){ %><div class="alert success">Session berhasil disimpan.</div><% } %><% if(error){ %><div class="alert error"><%= error %></div><% } %><form method="post" action="/site/<%= site.id %>/session-agent" class="stack"><label>Cookie Session<textarea name="cookie" rows="8" placeholder="PHPSESSID=...; cookie_lain=..." required></textarea></label><div class="row"><button class="btn primary">SIMPAN SESSION</button><button type="button" id="test" class="btn secondary">TEST SESSION</button></div></form><form method="post" action="/site/<%= site.id %>/session-agent/clear" onsubmit="return confirm('Hapus session <%= site.name %>?')"><button class="btn danger">HAPUS SESSION</button></form><div id="testResult"></div></section></main></div>
<script>document.getElementById('test').onclick=async()=>{const el=document.getElementById('testResult');el.innerHTML='<div class="alert">Mengecek...</div>';const r=await fetch('/site/<%= site.id %>/session-agent/test',{method:'POST'});const j=await r.json();el.innerHTML=`<div class="alert ${j.ok?'success':'error'}">${j.ok?j.message:j.error}</div>`}</script></body></html>
